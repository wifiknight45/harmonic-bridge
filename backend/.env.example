# App
APP_NAME=harmonic-bridge
DEBUG=true
SECRET_KEY=change-me-to-a-long-random-string
CORS_ORIGINS=http://localhost:5173,http://localhost:3000

# Database — SQLite by default; use Postgres for docker-compose
DATABASE_URL=sqlite+aiosqlite:///./harmonic_bridge.db
# DATABASE_URL=postgresql+asyncpg://harmonic:harmonic@localhost:5432/harmonic_bridge

# Spotify (Authorization Code flow)
SPOTIPY_CLIENT_ID=
SPOTIPY_CLIENT_SECRET=
SPOTIPY_REDIRECT_URI=http://localhost:8000/api/v1/auth/spotify/callback

# Apple Music (MusicKit / Developer Token ES256)
APPLE_DEVELOPER_KEY_ID=
APPLE_TEAM_ID=
APPLE_PRIVATE_KEY_PATH=./AuthKey.p8
APPLE_MUSIC_USER_TOKEN=

# Demo mode is automatic when Spotify/Apple credentials are missing
DEMO_MODE=auto
